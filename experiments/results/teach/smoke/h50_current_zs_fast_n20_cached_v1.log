"""
def answer(reasoning: str = None, answer: str = Ellipsis)
def ask(question: str)
def date_lookup(query: str, max_matches: int = 8) -> str # For exact date/time or N-days-ago questions, list matching history summaries directly
def event_date_lookup(query: str, max_matches: int = 12) -> str # For "how many days ago did you X" questions, find all matching event dates directly
def now() -> datetime.datetime
def object_lookup(object_name: str, max_matches: int = 8) -> str # For object yes/no questions, check whether task summaries mention the object
def task_list(max_tasks: int = 30) -> str # For task-list questions, list task-sized history summaries in chronological order
def task_lookup(query: str, max_matches: int = 8) -> str # For task-description questions, list task-sized summaries matching a query
def temporal_neighbor(target_task: str, direction: str = 'before', max_candidates: int = 6) -> str # For just-before/just-after questions, find the target task and return adjacent task candidates
def vqa(question: str, *images: PIL.Image.Image)
"""

